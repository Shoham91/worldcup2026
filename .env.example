# Copy to .env (local) and set the same values in Vercel (production).

# Neon Postgres — pooled connection (ends with -pooler...), used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon Postgres — direct connection (no -pooler), used by `prisma db push`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Long random string used to sign login cookies. Generate one, keep it secret.
SESSION_SECRET="change-me-to-a-long-random-string"

# Shared code everyone must enter to register. Share it with your players.
JOIN_CODE="change-me"

# Auto-results sync from football-data.org (free token) + a secret guarding /api/sync.
FOOTBALL_DATA_TOKEN="your-football-data-org-token"
SYNC_SECRET="a-long-random-string"
